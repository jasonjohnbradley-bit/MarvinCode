{
	"name": "chrome-tab",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "1.0.0",
	"publisher": "vscode",
	"license": "MIT",
	"engines": {
		"vscode": "^1.70.0"
	},
	"enabledApiProposals": [
		"externalUriOpener"
	],
	"main": "./out/extension",
	"categories": [
		"Other"
	],
	"extensionKind": [
		"ui"
	],
	"activationEvents": [
		"onStartupFinished",
		"onWebviewPanel:marvincode.chromeTab"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "chromeTab",
					"title": "%viewContainer.chromeTab%",
					"icon": "media/chrome-activity.svg"
				}
			]
		},
		"views": {
			"chromeTab": [
				{
					"id": "marvincode.chrome.launcher",
					"name": "%view.launcher%"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "marvincode.chrome.launcher",
				"contents": "%welcome.launcher%"
			}
		],
		"commands": [
			{
				"command": "marvincode.chrome.newTab",
				"title": "%command.newTab%",
				"category": "Chrome Tab"
			},
			{
				"command": "marvincode.chrome.toggleDarkMode",
				"title": "%command.toggleDarkMode%",
				"category": "Chrome Tab"
			},
			{
				"command": "marvincode.chrome.openUrl",
				"title": "%command.openUrl%",
				"category": "Chrome Tab"
			},
			{
				"command": "marvincode.chrome.openActiveBrowserPage",
				"title": "%command.openActiveBrowserPage%",
				"category": "Chrome Tab"
			},
			{
				"command": "marvincode.chrome.restart",
				"title": "%command.restart%",
				"category": "Chrome Tab"
			},
			{
				"command": "marvincode.chrome.showLogs",
				"title": "%command.showLogs%",
				"category": "Chrome Tab"
			}
		],
		"configuration": {
			"title": "%config.title%",
			"properties": {
				"marvincode.chrome.hosts": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"markdownDescription": "%config.hosts%"
				},
				"marvincode.chrome.executablePath": {
					"type": "string",
					"default": "",
					"markdownDescription": "%config.executablePath%"
				},
				"marvincode.chrome.deviceScaleFactor": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 4,
					"markdownDescription": "%config.deviceScaleFactor%"
				},
				"marvincode.chrome.colorScheme": {
					"type": "string",
					"enum": [
						"light",
						"dark",
						"theme"
					],
					"enumDescriptions": [
						"%config.colorScheme.light%",
						"%config.colorScheme.dark%",
						"%config.colorScheme.theme%"
					],
					"default": "light",
					"markdownDescription": "%config.colorScheme%"
				},
				"marvincode.chrome.forceDark": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "%config.forceDark%"
				},
				"marvincode.chrome.askBeforeSharing": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%config.askBeforeSharing%"
				},
				"marvincode.chrome.frameQuality": {
					"type": "number",
					"default": 80,
					"minimum": 30,
					"maximum": 100,
					"markdownDescription": "%config.frameQuality%"
				}
			}
		}
	}
}
