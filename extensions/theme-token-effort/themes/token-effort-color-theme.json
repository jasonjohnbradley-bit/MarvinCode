	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#6e6a4d", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "string.quoted"],
			"settings": { "foreground": "#a3b070" }
		},
		{
			"scope": ["string.regexp", "constant.regexp"],
			"settings": { "foreground": "#9fae62" }
		},
		{
			"scope": ["constant.character.escape"],
			"settings": { "foreground": "#d0703c" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "support.constant", "constant.other"],
			"settings": { "foreground": "#d0703c" }
		},
		{
			"scope": ["keyword", "keyword.control", "storage.modifier", "keyword.other"],
			"settings": { "foreground": "#c96a30" }
		},
		{
			"scope": ["storage", "storage.type"],
			"settings": { "foreground": "#c98f45", "fontStyle": "italic" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
			"settings": { "foreground": "#e0b264" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class", "entity.other.inherited-class"],
			"settings": { "foreground": "#c9a35c" }
		},
		{
			"scope": ["variable", "meta.definition.variable.name", "support.variable"],
			"settings": { "foreground": "#d3c5a4" }
		},
		{
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#c6b48e", "fontStyle": "italic" }
		},
		{
			"scope": ["variable.other.property", "variable.other.object.property", "support.type.property-name", "meta.object-literal.key"],
			"settings": { "foreground": "#bfae87" }
		},
		{
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#c96a30" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#c9a35c", "fontStyle": "italic" }
		},
		{
			"scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator", "punctuation.accessor", "meta.brace"],
			"settings": { "foreground": "#97876a" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#f8f8f0", "background": "#8e2418" }
		},
		{
			"scope": ["markup.heading", "markup.heading entity.name"],
			"settings": { "foreground": "#e0b264", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#a3b070" }
		},
		{
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#e34524" }
		},
		{
			"scope": ["markup.changed"],
			"settings": { "foreground": "#c98f45" }
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code.block"],
			"settings": { "foreground": "#9fae62" }
		},
		{
			"scope": ["string.other.link", "markup.underline.link"],
			"settings": { "foreground": "#d99a4e", "fontStyle": "underline" }
		},
		{
			"scope": ["meta.preprocessor", "keyword.control.directive"],
			"settings": { "foreground": "#b8874a" }
		}
	]
}
