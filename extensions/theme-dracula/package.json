{
  "name": "theme-dracula",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "2.25.1",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "categories": ["Themes"],
  "contributes": {
    "themes": [
      {
        "id": "Dracula Theme",
        "label": "%themeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/dracula-color-theme.json"
      },
      {
        "id": "Dracula Theme Soft",
        "label": "%themeSoftLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/dracula-soft-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Solarized Dark"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
