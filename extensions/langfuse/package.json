{
	"name": "langfuse",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "1.0.0",
	"publisher": "vscode",
	"license": "MIT",
	"engines": {
		"vscode": "^1.70.0"
	},
	"main": "./out/extension",
	"categories": [
		"Other"
	],
	"extensionKind": [
		"ui",
		"workspace"
	],
	"activationEvents": [],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "langfuse",
					"title": "%viewContainer.langfuse%",
					"icon": "media/langfuse-icon.svg"
				}
			]
		},
		"views": {
			"langfuse": [
				{
					"id": "langfuse.traces",
					"name": "%view.traces%"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "langfuse.traces",
				"when": "!langfuse.connected",
				"contents": "%welcome.disconnected%"
			},
			{
				"view": "langfuse.traces",
				"when": "langfuse.connected",
				"contents": "%welcome.connected%"
			}
		],
		"commands": [
			{
				"command": "langfuse.setKeys",
				"title": "%command.setKeys%",
				"category": "Langfuse",
				"icon": "$(key)"
			},
			{
				"command": "langfuse.refresh",
				"title": "%command.refresh%",
				"category": "Langfuse",
				"icon": "$(refresh)"
			},
			{
				"command": "langfuse.setFilter",
				"title": "%command.setFilter%",
				"category": "Langfuse",
				"icon": "$(filter)"
			},
			{
				"command": "langfuse.clearFilter",
				"title": "%command.clearFilter%",
				"category": "Langfuse",
				"icon": "$(clear-all)"
			},
			{
				"command": "langfuse.toggleAutoRefresh",
				"title": "%command.toggleAutoRefresh%",
				"category": "Langfuse",
				"icon": "$(sync)"
			},
			{
				"command": "langfuse.openTrace",
				"title": "%command.openTrace%",
				"category": "Langfuse"
			},
			{
				"command": "langfuse.openInLangfuse",
				"title": "%command.openInLangfuse%",
				"category": "Langfuse",
				"icon": "$(link-external)"
			},
			{
				"command": "langfuse.copyTraceId",
				"title": "%command.copyTraceId%",
				"category": "Langfuse"
			},
			{
				"command": "langfuse.disconnect",
				"title": "%command.disconnect%",
				"category": "Langfuse"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "langfuse.refresh",
					"when": "view == langfuse.traces && langfuse.connected",
					"group": "navigation@1"
				},
				{
					"command": "langfuse.setFilter",
					"when": "view == langfuse.traces && langfuse.connected",
					"group": "navigation@2"
				},
				{
					"command": "langfuse.toggleAutoRefresh",
					"when": "view == langfuse.traces && langfuse.connected",
					"group": "navigation@3"
				},
				{
					"command": "langfuse.clearFilter",
					"when": "view == langfuse.traces && langfuse.connected",
					"group": "1_filter@1"
				},
				{
					"command": "langfuse.setKeys",
					"when": "view == langfuse.traces",
					"group": "9_config@1"
				},
				{
					"command": "langfuse.disconnect",
					"when": "view == langfuse.traces && langfuse.connected",
					"group": "9_config@2"
				}
			],
			"view/item/context": [
				{
					"command": "langfuse.openInLangfuse",
					"when": "view == langfuse.traces && viewItem == langfuseTrace",
					"group": "inline@1"
				},
				{
					"command": "langfuse.openInLangfuse",
					"when": "view == langfuse.traces && viewItem == langfuseTrace",
					"group": "1_actions@1"
				},
				{
					"command": "langfuse.copyTraceId",
					"when": "view == langfuse.traces && viewItem == langfuseTrace",
					"group": "1_actions@2"
				}
			],
			"commandPalette": [
				{
					"command": "langfuse.openTrace",
					"when": "false"
				},
				{
					"command": "langfuse.openInLangfuse",
					"when": "false"
				},
				{
					"command": "langfuse.copyTraceId",
					"when": "false"
				}
			]
		},
		"configuration": [
			{
				"title": "Langfuse",
				"properties": {
					"langfuse.host": {
						"type": "string",
						"default": "https://us.cloud.langfuse.com",
						"description": "%configuration.host%"
					},
					"langfuse.publicKey": {
						"type": "string",
						"default": "",
						"description": "%configuration.publicKey%"
					},
					"langfuse.traceLimit": {
						"type": "number",
						"default": 50,
						"minimum": 1,
						"maximum": 100,
						"description": "%configuration.traceLimit%"
					},
					"langfuse.autoRefreshSeconds": {
						"type": "number",
						"default": 0,
						"minimum": 0,
						"maximum": 600,
						"description": "%configuration.autoRefreshSeconds%"
					}
				}
			}
		]
	},
	"scripts": {
		"compile": "gulp compile-extension:langfuse",
		"watch": "gulp watch-extension:langfuse"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/microsoft/vscode.git"
	}
}
